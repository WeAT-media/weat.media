{
  "lexicon": 1,
  "id": "media.weat.comment",
  "description": "Комментарий к статье media.weat.article; хранится в репозитории автора комментария.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "text", "createdAt"],
        "properties": {
          "subject": { "type": "ref", "ref": "#subjectRef", "description": "Статья, к которой оставлен комментарий" },
          "reply": { "type": "ref", "ref": "#replyRef" },
          "text": { "type": "string", "maxLength": 100000, "maxGraphemes": 10000 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "subjectRef": {
      "type": "object",
      "required": ["uri"],
      "properties": { "uri": { "type": "string", "format": "at-uri" } }
    },
    "replyRef": {
      "type": "object",
      "required": ["parent"],
      "properties": { "parent": { "type": "ref", "ref": "#subjectRef" } }
    }
  }
}
