# Маршруты Zitadel: Login UI (Next.js) и API (gRPC/Connect по h2c) за одним адресом
:80 {
	@login path /ui/v2/login /ui/v2/login/*
	handle @login {
		reverse_proxy zitadel-login:3000
	}
	@root path /
	handle @root {
		rewrite * /ui/v2/login/
		reverse_proxy zitadel-login:3000
	}
	handle {
		reverse_proxy h2c://zitadel-api:8080
	}
}
