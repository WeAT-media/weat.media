# cp .env.example .env — значения ниже для локального стенда; на узлах — свои секреты
ZITADEL_VERSION=v4.20.2

# публичный адрес сервиса входа; должен совпадать с тем, что видит браузер, иначе «Instance not found»
ZITADEL_DOMAIN=localhost
ZITADEL_EXTERNALPORT=8080
ZITADEL_EXTERNALSECURE=false
ZITADEL_PUBLIC_SCHEME=http
ZITADEL_PUBLIC_URL=http://localhost:8080
PROXY_PORT=8080
# узел: ZITADEL_DOMAIN=auth.weat.media ZITADEL_EXTERNALPORT=443 ZITADEL_EXTERNALSECURE=true
#       ZITADEL_PUBLIC_SCHEME=https ZITADEL_PUBLIC_URL=https://auth.weat.media

ZITADEL_ORG_NAME=weat.media
# ровно 32 символа, менять после первого запуска нельзя: openssl rand -hex 16
ZITADEL_MASTERKEY=
# openssl rand -base64 32
LOGIN_SESSION_COOKIE_SECRET=
POSTGRES_PASSWORD=
ZITADEL_ADMIN_PASSWORD=
ZITADEL_ADMIN_PASSWORD_CHANGE=true
PAT_EXPIRATION=2030-01-01T00:00:00Z
