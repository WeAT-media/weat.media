# Один Caddyfile на все узлы; различия — только в переменных окружения (deploy/node/.env).
#
#   SITE_DOMAINS   — домены сайта на этом узле:
#                    глобальный: "weat.media nl-1.weat.media"   РФ: "weat.media ru.weat.media"
#   PDS_HOST       — адрес PDS контура (технический, пользователь его не видит):
#                    глобальный: pds.weat.media      РФ: pds-ru.weat.media
#
#   ACME_DNS_*     — учётка acme-dns для DNS-01 (общая для обоих контуров: _acme-challenge один)
#
# Ресурс один: handle у всех вида alina.weat.media, на любом узле. Связь handle -> DID
# публичная, общий справочник реплицируется между контурами; персональные данные — нет.
{
	email {$ACME_EMAIL}
	servers {
		# реальный IP клиента нужен GeoIP AppView; доверяем только локальной сети compose
		trusted_proxies static private_ranges
		# медленные клиенты (slowloris) не держат соединения бесконечно
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
		max_header_size 32KB
	}
	order rate_limit before basic_auth
}

# Частота запросов с одного IP. Вторая линия — лимитер AppView, третья — DDoS-защита провайдера.
(edge_limits) {
	rate_limit {
		zone auth {
			match {
				method POST
				path /api/auth/login /api/auth/register /api/auth/mfa /api/auth/handoff /api/auth/password/*
			}
			key {client_ip}
			events 20
			window 1m
		}
		zone beacon {
			match {
				path /analytics-api/collect
			}
			key {client_ip}
			events 120
			window 1m
		}
		zone api {
			match {
				path /api/* /analytics-api/*
				not path /api/webhooks/payment
			}
			key {client_ip}
			events 1200
			window 1m
		}
	}
	# тело запроса: платные статьи до 200 КБ текста, остальное меньше
	request_body {
		max_size 1MB
	}
}

(tls_dns) {
	tls {
		dns acmedns {
			username {$ACME_DNS_USERNAME}
			password {$ACME_DNS_PASSWORD}
			subdomain {$ACME_DNS_SUBDOMAIN}
			server_url {$ACME_DNS_SERVER}
		}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
}

# CSP только для SPA. style 'unsafe-inline' — BlockSuite и recharts задают стили атрибутами;
# скрипты — только свои. Видео-встраивания (YouTube и др.) — через frame-src https:.
(csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self' https://{$STATIC_HOST:static.weat.media} 'sha256-Nc3HIclqT9dneDiA5RiE70hDQ9VFwrFp9Fru491OCc4=' 'inline-speculation-rules' 'wasm-unsafe-eval'; style-src 'self' https://{$STATIC_HOST:static.weat.media} 'unsafe-inline'; font-src 'self' https://{$STATIC_HOST:static.weat.media} data:; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https://{$PDS_HOST} https://{$AUTH_HOST:auth.weat.media}; frame-src 'self' https: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
}

{$SITE_DOMAINS} {
	import tls_dns
	import security_headers
	import csp
	import edge_limits
	encode zstd gzip

	# служебные страницы не индексировать, даже если на них где-то есть ссылка (robots.txt — только просьба не обходить)
	@noindex path /admin /admin/* /api/* /crawler-api/* /analytics-api/* /settings /settings/* /profile/*/settings* /login /login/* /auth/* /compose /shared-draft/* /ads/dashboard /support/tickets /purchase/* /after-payments
	header @noindex X-Robots-Tag "noindex, nofollow"

	# какой контур ответил — для отладки GeoDNS и мониторинга
	header X-Indie-Contour {$CONTOUR}

	# Читаемый HTML, метатеги и BlogPosting для соцсетей, поисковых и AI-краулеров.
	@share_bot {
		path_regexp article ^/article/([^/]+)$
		header_regexp User-Agent (?i)(facebookexternalhit|facebot|twitterbot|telegrambot|whatsapp|slackbot|discordbot|linkedinbot|vkshare|skypeuripreview|pinterest|redditbot|embedly|bluesky|cardyb|mastodon|viber|googlebot|bingbot|yandexbot|duckduckbot|baiduspider|gptbot|chatgpt-user|oai-searchbot|claudebot|claude-user|perplexitybot|applebot|amazonbot)
	}
	handle @share_bot {
		rewrite * /api/share/article/{re.article.1}
		reverse_proxy appview:8787
	}

	# Карта публичных статей и авторов формируется из того же регионального индекса.
	@sitemap path /sitemap.xml
	handle @sitemap {
		rewrite * /api/sitemap.xml
		reverse_proxy appview:8787
	}

	# /api/* — AppView; сама страница /api — SPA (документация)
	@api path /api/*
	handle @api {
		reverse_proxy appview:8787
	}

	# админка краулера: краулер на отдельном VPS (CRAWLER_API_URL=https://crawler-api.weat.media)
	@crawler path /crawler-api/*
	handle @crawler {
		reverse_proxy {$CRAWLER_API_URL:http://127.0.0.1:9} {
			header_up Host {upstream_hostport}
		}
	}

	# RSS (сервис ленты через AppView): /rss/author/<handle>, /rss/comments/<did>/<rkey>
	@rss path /rss/*
	handle @rss {
		# через AppView: в РФ-контуре из RSS убираются записи с метками nsfw/politics (server/src/restricted.ts)
		rewrite * /api{uri}
		reverse_proxy appview:8787
	}

	# открытая аналитика (Rust): beacon и агрегаты
	@analytics path /analytics-api/*
	handle @analytics {
		reverse_proxy analytics:8789
	}

	# Сборка SPA. Файлы /assets/* — с хешем в имени: кэш навсегда; нет файла — 404, а не index.html
	# (иначе import() куска страницы получал HTML и экран оставался белым до перезагрузки).
	# index.html и прочее — no-cache: браузер каждый раз сверяет ETag и после деплоя берёт новую сборку.
	@assets path /assets/*
	handle @assets {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Пререндеренная главная одинакова для всех гостей. Браузер ревалидирует её,
	# а CDN может пять минут отдавать общий кэш и сутки обновлять его в фоне.
	@homepage path /
	handle @homepage {
		root * /srv
		header Cache-Control "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
		rewrite * /index.html
		file_server
	}
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /app.html
		file_server
	}
}

# PDS этого контура (его адрес записан в DID-документах его пользователей)
{$PDS_HOST} {
	import tls_dns
	import security_headers

	# admin API PDS и выпуск инвайтов — только с адресов краулера/админов (ADMIN_ALLOW_IPS)
	@admin {
		path /xrpc/com.atproto.admin.* /xrpc/com.atproto.server.createInviteCode*
		not remote_ip {$ADMIN_ALLOW_IPS:127.0.0.1/32}
	}
	respond @admin 404

	# вход снаружи — через AppView: у аккаунтов с TOTP полный вход паролем без второго фактора закрыт
	# (server/src/pdsGate.ts); пароли приложений и аккаунты без TOTP работают как обычно
	handle /xrpc/com.atproto.server.createSession {
		rewrite * /api/pds/createSession
		reverse_proxy appview:8787
	}

	# подбор паролей напрямую в PDS, минуя AppView
	rate_limit {
		zone pds_auth {
			match {
				path /xrpc/com.atproto.server.createSession /xrpc/com.atproto.server.createAccount /xrpc/com.atproto.server.requestPasswordReset /xrpc/com.atproto.server.resetPassword
			}
			key {client_ip}
			events 20
			window 1m
		}
		zone pds {
			key {client_ip}
			events 3000
			window 1m
		}
	}
	request_body {
		# blob-загрузки (картинки) — до 50 МБ
		max_size 50MB
	}
	handle {
		reverse_proxy pds:2583
	}
}

# Вход сотрудников (Zitadel, deploy/auth): Login UI и API (gRPC/Connect по h2c) за одним адресом.
# Стек auth поднят не на каждом узле: без него — 502, сайт это не задевает.
{$AUTH_HOST:auth.weat.media} {
	import tls_dns
	import security_headers
	# подбор пароля сотрудника: попытки входа с одного IP. Вторая линия — блокировка учётки в Zitadel (Lockout policy)
	rate_limit {
		zone staff_login {
			match {
				method POST
				path /ui/v2/login/* /zitadel.session.v2.SessionService/* /v2/sessions* /oauth/v2/token
			}
			key {client_ip}
			events 10
			window 5m
		}
	}
	@login path /ui/v2/login /ui/v2/login/*
	handle @login {
		reverse_proxy zitadel-login:3000
	}
	@root path /
	handle @root {
		redir /ui/v2/login/ 302
	}
	handle {
		reverse_proxy h2c://zitadel-api:8080
	}
}

# Почтовый сервер (deploy/mail) берёт сертификат этого имени из тома caddy-data.
# По HTTP здесь ничего нет; блок нужен, чтобы Caddy получал и продлевал сертификат.
{$MAIL_HOST:mail.weat.media} {
	import tls_dns
	respond 404
}

# Коллегии присяжных (services/labeler): <id>.justice.weat.media — DID-документ, queryLabels, subscribeLabels.
# Сертификат *.justice.weat.media — DNS-01, CNAME _acme-challenge.justice на тот же acme-dns.
*.{$LABELER_DOMAIN:justice.weat.media} {
	import tls_dns
	import security_headers
	# запись меток — только AppView соседнего контура (LABELER_PEER_IPS) и по токену; остальным /admin нет
	@write {
		path /admin/*
		not remote_ip {$LABELER_PEER_IPS:127.0.0.1/32}
	}
	respond @write 404
	reverse_proxy labeler:8791
}

# www — постоянный 301 на основной адрес: для поисковиков это один сайт, а не два одинаковых.
# Точный адрес важнее «*» ниже, поэтому www не уходит в профиль пользователя.
www.{$PDS_HANDLE_DOMAIN} {
	import tls_dns
	redir https://{$PDS_HANDLE_DOMAIN}{uri} 301
}

# Только статика для Gcore CDN. Модули ES и шрифты требуют CORS с основного сайта.
{$STATIC_HOST:static.weat.media} {
	import tls_dns
	import security_headers
	encode zstd gzip
	root * /srv
	header Access-Control-Allow-Origin "https://{$PDS_HANDLE_DOMAIN}"
	@static_assets path /assets/*
	handle @static_assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	@static_fonts path /fonts/*
	handle @static_fonts {
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle {
		respond 404
	}
}

# handle любого пользователя: alina.<PDS_HANDLE_DOMAIN>/.well-known/atproto-did.
# Отвечает AppView по общему справочнику — пользователь может жить в любом контуре.
*.{$PDS_HANDLE_DOMAIN} {
	import tls_dns
	import security_headers
	@did path /.well-known/atproto-did
	handle @did {
		rewrite * /api/handles/resolve
		reverse_proxy appview:8787
	}
	handle {
		redir https://{$PDS_HANDLE_DOMAIN}/profile/{host} 302
	}
}
