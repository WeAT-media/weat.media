# PDS контура. ОДИНАКОВЫЙ на primary и standby (резерв восстанавливается из копии).
#   global: PDS_HOSTNAME=pds.weat.media     ru: PDS_HOSTNAME=pds-ru.weat.media
# handle общие для обоих контуров (.weat.media) — уникальность проверяет AppView
PDS_HOSTNAME=pds.weat.media
PDS_SERVICE_HANDLE_DOMAINS=.weat.media
# openssl rand -hex 16
PDS_JWT_SECRET=
PDS_ADMIN_PASSWORD=
# ключ ротации PLC: потеря = потеря управления DID всех пользователей контура. Хранить в сейфе.
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_REPORT_SERVICE_URL=https://mod.bsky.app
PDS_REPORT_SERVICE_DID=did:plc:ar7c4by46qjdydhdevvrndac
PDS_CRAWLERS=https://bsky.network
# письма (коды 2FA, сброс пароля): SMTP своего контура
PDS_EMAIL_SMTP_URL=
PDS_EMAIL_FROM_ADDRESS=noreply@weat.media
