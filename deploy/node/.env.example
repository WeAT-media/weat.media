# ── узел ─────────────────────────────────────────────────────────────────
# global | ru
CONTOUR=global
# primary — принимает запись; standby — горячий резерв (подписка БД, AppView только читает)
NODE_ROLE=primary
# для docker compose: на primary включает pds-backup
COMPOSE_PROFILES=primary

# ── адреса ───────────────────────────────────────────────────────────────
# Один адрес для всех: weat.media через GeoDNS (РФ -> Yandex, остальные -> NL-1).
# ru.weat.media — запасной вход в РФ-контур, nl-1.weat.media — прямой адрес NL (мимо GeoDNS).
#   global: SITE_DOMAINS=weat.media nl-1.weat.media
#   ru:     SITE_DOMAINS=weat.media ru.weat.media
SITE_DOMAINS=weat.media nl-1.weat.media
#   global: pds.weat.media        ru: pds-ru.weat.media   (технический адрес PDS контура)
PDS_HOST=pds.weat.media
PUBLIC_URL=https://weat.media
# handle одинаковые во всех контурах: alina.weat.media
PDS_HANDLE_DOMAIN=weat.media
# AppView другого контура: проверка занятости handle и переадресация входа
#   global: https://ru.weat.media           ru: https://nl-1.weat.media (прямой адрес NL, мимо GeoDNS)
PEER_CONTOUR_URL=

# ── TLS: DNS-01 через acme-dns — ОДНА учётка на оба контура (одна запись _acme-challenge) ─
ACME_EMAIL=admin@weat.media
ACME_DNS_SERVER=https://auth.acme-dns.io
ACME_DNS_USERNAME=
ACME_DNS_PASSWORD=
ACME_DNS_SUBDOMAIN=

# ── база ─────────────────────────────────────────────────────────────────
# NL-1 / RU VPS: свой postgres из compose
#   DATABASE_URL=postgres://indie:<PG_PASSWORD>@postgres:5432/indie
# Yandex:   postgres://indie:<pwd>@<host>.mdb.yandexcloud.net:6432/indie?sslmode=verify-full
# Supabase: postgres://postgres.<ref>:<pwd>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
PG_PASSWORD=
# публикация для standby: адрес primary, к которому подписывается резерв (deploy/db)
REPLICATION_PRIMARY_DSN=

# ── AppView (server/.env.example — полный список) ────────────────────────
# ОДИНАКОВЫЕ на primary и standby одного контура, иначе после переключения
# не расшифруются пароли привязанных аккаунтов и TOTP
SECRETS_KEY=
ADMIN_TOKEN=
# платные тексты: ОДИНАКОВЫЙ на primary и standby (openssl rand -hex 32)
PAID_CONTENT_KEY=
PDS_ADMIN_PASSWORD=
GEOIP_DB_PATH=/geoip/GeoLite2-Country.mmdb
CORS_ORIGIN=https://weat.media

# ── резервная копия PDS (restic -> S3 своего контура) ────────────────────
#   global: S3 в NL       ru: Yandex Object Storage (s3:https://storage.yandexcloud.net/<bucket>)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_INTERVAL_SEC=300

# открытая аналитика (services/analytics)
ANALYTICS_DATABASE_URL=postgres://indie:CHANGE@postgres:5432/analytics
# openssl rand -hex 32; одинаковый на узлах контура
ANALYTICS_VISITOR_SECRET=

# IP краулера и админов для admin API PDS (createInviteCode и т.п.), через пробел; остальным — 404
ADMIN_ALLOW_IPS=127.0.0.1/32

# API краулера на его VPS (deploy/crawler); пусто — /crawler-api/* недоступен
CRAWLER_API_URL=https://crawler-api.weat.media

# лента (services/feed): своя БД-индекс; пересобирается из репозиториев, бэкап не обязателен
FEED_DATABASE_URL=postgres://indie:CHANGE@postgres:5432/feed
