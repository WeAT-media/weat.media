# Краулер вне контуров (полный список переменных — services/crawler/.env.example)
PG_PASSWORD=
# openssl rand -hex 32 — пароль Redis (requirepass); только [0-9a-f], чтобы не ломать REDIS_URL
REDIS_PASSWORD=
# PDS глобального контура: здесь живут аккаунты краулеров
PDS_URL=https://pds.weat.media
# = PDS_ADMIN_PASSWORD из .env.pds глобального контура
PDS_ADMIN_PASSWORD=
PDS_HANDLE_DOMAIN=weat.media
# openssl rand -hex 32 — свой ключ, не общий с AppView
SECRETS_KEY=
# openssl rand -hex 32
ADMIN_TOKEN=
USER_AGENT=WEATCrawlerBot/1.0 (+https://weat.media/crawler)
CONCURRENCY=2
RATE_MS=2000

# Публичный адрес API краулера (DNS A-запись на этот VPS) и IP узлов сайта, которым он открыт
CRAWLER_API_HOST=crawler-api.weat.media
EDGE_IPS=203.0.113.10/32 203.0.113.20/32
# Вход сотрудников (Zitadel глобального контура)
ZITADEL_ISSUER=https://auth.weat.media
ZITADEL_PROJECT_ID=
