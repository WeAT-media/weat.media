# Бренд и адреса инсталляции (фронтенд, переменные сборки Vite)
VITE_SITE_NAME=weAT.media
# домен handle пользователей: alina.<VITE_HANDLE_DOMAIN>
VITE_HANDLE_DOMAIN=example.org
VITE_PDS_URL=https://pds.example.org
VITE_SITE_URL=https://example.org
# CDN для JS/CSS и шрифтов; пусто или / — те же файлы с основного домена
VITE_STATIC_URL=/
# AGPL-3.0: пользователи сетевого сервиса должны иметь доступ к исходникам
VITE_SOURCE_URL=https://github.com/WeAT-media/weat.media
# подтверждение владения в поисковых кабинетах (meta-теги), необязательно
SITE_VERIFY_GOOGLE=
SITE_VERIFY_YANDEX=
SITE_VERIFY_BING=

# Zitadel (deploy/auth, auth.weat.media): только вход сотрудников в /admin; читатели входят через PDS.
# Значения печатает server/scripts/zitadel-bootstrap.ts
VITE_ZITADEL_ISSUER=
VITE_ZITADEL_CLIENT_ID=
VITE_ZITADEL_PROJECT_ID=
