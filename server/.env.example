PORT=8787
DATABASE_URL=postgres://indie:indie@localhost:5432/indie
PDS_URL=http://localhost:2583
# совпадает с PDS_ADMIN_PASSWORD в .env.pds
PDS_ADMIN_PASSWORD=change-me
PDS_HANDLE_DOMAIN=weat.media
# global | ru (ru: регистрация только с российских IP; вход открыт отовсюду)
CONTOUR=global
# GeoLite2-Country.mmdb: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_DB_PATH=./data/GeoLite2-Country.mmdb
# страна для localhost в разработке
GEOIP_DEV_COUNTRY=RU
# true только за своим reverse proxy, иначе X-Forwarded-For подделывается
TRUST_PROXY=false
# openssl rand -hex 32
ADMIN_TOKEN=
CORS_ORIGIN=http://localhost:3000
# openssl rand -hex 32
SECRETS_KEY=
PUBLIC_URL=http://localhost:3000
# https://oauth.yandex.ru/client/new, redirect URI: PUBLIC_URL/api/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# https://console.cloud.google.com/apis/credentials, redirect URI: PUBLIC_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://github.com/settings/developers, callback: PUBLIC_URL/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# @BotFather: /newbot, затем /setdomain <домен сайта>
TELEGRAM_BOT_TOKEN=
# вход через внешний AT-аккаунт; в проде PUBLIC_URL должен быть https (client-metadata.json)
ATPROTO_OAUTH=true
# ключ закрытого хранилища платных текстов — отдельно от SECRETS_KEY (openssl rand -hex 32)
PAID_CONTENT_KEY=

# lava.top: оплата платных статей. Продукт в кабинете — «Цена по запросу API», его offerId сюда.
# Вебхук в кабинете: https://<сайт>/api/webhooks/payment, авторизация API key = LAVA_WEBHOOK_SECRET
LAVA_API_KEY=
LAVA_OFFER_ID=
LAVA_WEBHOOK_SECRET=

# Zitadel: сервис входа (deploy/auth). Значения печатает server/scripts/zitadel-bootstrap.ts
ZITADEL_ISSUER=
ZITADEL_PROJECT_ID=
ZITADEL_CLIENT_ID=

# сервис ленты (services/feed); пусто — лента обходом PDS
FEED_URL=
