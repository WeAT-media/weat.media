{
  "name": "atproto-media-appview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "test": "tsx --test test/*.test.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/seedDemo.ts"
  },
  "dependencies": {
    "@atproto/oauth-client-node": "^0.5.16",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "@resvg/resvg-js": "^2.6.2",
    "hono": "^4.13.0",
    "imapflow": "^2.11.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.17",
    "mailparser": "^3.14.3",
    "maxmind": "^5.0.0",
    "nodemailer": "^10.5.0",
    "postgres": "^3.4.5",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "undici": "^8.12.4",
    "yjs": "^13.6.33",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "overrides": {
      "fflate": "^0.7.5",
      "zod@<4.6.6": "^4.6.6"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "AGPL-3.0-or-later"
}
