# cp .env.pds.example .env.pds и заполнить
PDS_HOSTNAME=pds.weat.media
PDS_SERVICE_HANDLE_DOMAINS=.weat.media
# openssl rand -hex 16
PDS_JWT_SECRET=
# openssl rand -base64 32 — admin API PDS снаружи закрыт (Caddy), но пароль всё равно должен быть сильным
PDS_ADMIN_PASSWORD=
# openssl ecparam --name secp256k1 --genkey --noout --outform DER | tail --bytes=+8 | head --bytes=32 | xxd --plain --cols 32
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
# локально: true (http, без TLS)
PDS_DEV_MODE=true
