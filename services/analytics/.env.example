DATABASE_URL=postgres://indie:indie@localhost:5432/analytics
# openssl rand -hex 32 — ключ дневного хеша посетителя; одинаковый на всех экземплярах контура
VISITOR_SECRET=
PORT=8789
# домены площадки: переходы с них считаются каналом «лента»
OWN_HOSTS=weat.media,localhost,127.0.0.1
CORS_ORIGIN=http://localhost:3000
# за Caddy: true (X-Forwarded-For)
TRUST_PROXY=false
FLUSH_MS=1000
QUEUE_SIZE=50000
