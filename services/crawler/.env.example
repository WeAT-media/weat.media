PORT=8788
# all | api | worker — воркер можно запускать отдельным лёгким процессом
ROLE=all
DATABASE_URL=postgres://indie:indie@localhost:5432/indie
REDIS_URL=redis://localhost:6379
PDS_URL=http://localhost:2583
# = PDS_ADMIN_PASSWORD из server/.env.pds
PDS_ADMIN_PASSWORD=
PDS_HANDLE_DOMAIN=weat.media
# openssl rand -hex 32 — свой ключ, не общий с AppView
SECRETS_KEY=
# openssl rand -hex 32
ADMIN_TOKEN=
USER_AGENT=WeatMediaCrawler/0.1 (+https://weat.media/crawler)
CONCURRENCY=2
RATE_MS=2000
